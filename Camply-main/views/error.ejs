<div class="row">
  <div class="col-6 offset-3">
    <div class="alert alert-danger" role="alert">
      <% if (process.env.NODE_ENV !== "production") { %>
        <h4 class="alert-heading"><%= err.message %></h4>
        <pre><%= err.stack %></pre>
      <% } else { %>
        <h4 class="alert-heading">Something went wrong.</h4>
      <% } %>
    </div>
  </div>
</div>
